NINE_ROUTER_BASE_URL=http://127.0.0.1:20128/v1
NINE_ROUTER_API_KEY=
NINE_ROUTER_PROVIDER_NAME=9Router free model pool
NINE_ROUTER_TIMEOUT_MS=18000
NINE_ROUTER_MODELS=oc/deepseek-v4-flash-free,oc/qwen3.6-plus-free,kr/claude-sonnet-4.5,kr/deepseek-3.2,kr/qwen3-coder-next,kr/glm-5,kr/MiniMax-M2.5,kr/claude-haiku-4.5,vertex/gemini-3.1-pro-preview,vertex-partner/deepseek-v3.2-maas
AGENT_ENABLE_DEFAULT_FREE_PROVIDERS=true
AGENT_ALLOWED_ORIGINS=https://wuyi-with-ai.pages.dev,https://wuyi-with-ai.vercel.app,http://127.0.0.1:5173,http://localhost:5173

# Optional. Use this when Cloudflare Pages should call the Vercel free serverless agent endpoint.
# VITE_AGENT_API_URL=https://wuyi-with-ai.vercel.app/api/agent

# 9Router is free open-source routing software. It still needs a reachable 9Router
# server plus whichever free provider accounts you enable in that router.
# If your 9Router endpoint requires a bearer token, put it in NINE_ROUTER_API_KEY.

# Optional free fallback providers. Add only the free keys you actually have.
# OPENROUTER_API_KEY=your-free-openrouter-key
# OPENROUTER_MODEL=openai/gpt-oss-20b:free
# GROQ_API_KEY=your-free-groq-key
# GROQ_MODEL=openai/gpt-oss-20b
# GEMINI_API_KEY=your-free-google-ai-studio-key
# GEMINI_MODEL=gemini-2.5-flash

# Optional custom fallback providers:
# AGENT_MODEL_PROVIDERS=Name|https://provider.example/v1|model-id|optional-api-key;Another|https://example.com/openai|openai|
