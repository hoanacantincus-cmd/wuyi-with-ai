NINE_ROUTER_BASE_URL=http://127.0.0.1:20128/v1
NINE_ROUTER_API_KEY=
NINE_ROUTER_PROVIDER_NAME=9Router free model pool
NINE_ROUTER_TIMEOUT_MS=18000
NINE_ROUTER_MODELS=oc/deepseek-v4-flash-free,oc/qwen3.6-plus-free,kr/claude-sonnet-4.5,kr/deepseek-3.2,kr/qwen3-coder-next,kr/glm-5,kr/MiniMax-M2.5,kr/claude-haiku-4.5,vertex/gemini-3.1-pro-preview,vertex-partner/deepseek-v3.2-maas
AGENT_ENABLE_DEFAULT_FREE_PROVIDERS=true
AGENT_ALLOWED_ORIGINS=https://wuyi-with-ai.pages.dev,https://wuyi-with-ai.vercel.app,http://127.0.0.1:5173,http://localhost:5173

# Optional. Use this when Cloudflare Pages should call the Vercel free serverless agent endpoint.
# VITE_AGENT_API_URL=https://wuyi-with-ai.vercel.app/api/agent

# Optional. Anonymous website analytics. Use Upstash Redis REST credentials from
# the Vercel Marketplace/Upstash console. The admin password is only sent to
# /api/analytics as an Authorization bearer token from /admin-analytics.
# VITE_ANALYTICS_API_URL=https://wuyi-with-ai.vercel.app/api/analytics
# ANALYTICS_ALLOWED_ORIGINS=https://wuyi-with-ai.pages.dev,https://wuyi-with-ai.vercel.app,http://127.0.0.1:5173,http://localhost:5173
# UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-upstash-standard-token
# ANALYTICS_ADMIN_PASSWORD=change-this-long-private-password
# ANALYTICS_SALT=change-this-random-salt

# 9Router is free open-source routing software. It still needs a reachable 9Router
# server plus whichever free provider accounts you enable in that router.
# If your 9Router endpoint requires a bearer token, put it in NINE_ROUTER_API_KEY.

# Optional free fallback providers. Add only the free keys you actually have.
# Volcengine Ark is tried first when configured. The default base URL/model list
# below matches the standard Ark free resource package. The first three IDs were
# smoke-tested from this project; the Kimi/Vision IDs are kept as optional
# activated-model fallbacks if your Ark account exposes them for chat.
# ARK_API_KEY=your-volcengine-ark-api-key
# ARK_MODELS=deepseek-v3-2-251201,glm-4-7-251222,doubao-seed-2-0-pro-260215,doubao-1-5-vision-pro-32k-250115,kimi-k2-250905,kimi-k2-thinking-251104
# ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# ARK_IMAGE_MODELS=doubao-seedream-5-0-260128,doubao-seedream-4-0-250828,doubao-seedream-4-5-251128
# ARK_IMAGE_SIZE=2K
#
# If you use Ark Coding Plan instead of the standard free resource package,
# switch to the Coding Plan base URL and Coding Plan model names.
# ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/coding/v3
# ARK_MODELS=ark-code-latest,doubao-seed-2.0-lite,doubao-seed-2.0-pro,doubao-seed-code
# If you use a private inference endpoint, set the model to your ep-... ID.
# ARK_MODEL=ep-your-deepseek-endpoint-id
# VOLCENGINE_ARK_MODEL=ep-your-inference-endpoint-id
# OPENROUTER_API_KEY=your-free-openrouter-key
# OPENROUTER_MODEL=openai/gpt-oss-20b:free
# GROQ_API_KEY=your-free-groq-key
# GROQ_MODEL=openai/gpt-oss-20b
# GEMINI_API_KEY=your-free-google-ai-studio-key
# GEMINI_MODEL=gemini-2.5-flash
# HF_TOKEN=your-free-huggingface-token
# HUGGINGFACE_MODEL=deepseek-ai/DeepSeek-R1:fastest
# GITHUB_MODELS_TOKEN=your-github-pat-with-models-read
# GITHUB_MODELS_MODEL=openai/gpt-4o-mini
# SILICONFLOW_API_KEY=your-siliconflow-key
# SILICONFLOW_MODEL=Qwen/Qwen3-8B
# CEREBRAS_API_KEY=your-cerebras-key
# CEREBRAS_MODEL=gpt-oss-120b
# SAMBANOVA_API_KEY=your-sambanova-key
# SAMBANOVA_MODEL=DeepSeek-V3.2

# Optional multi-model fallback lists for the providers above. The agent tries each model in order.
# VOLCENGINE_ARK_MODELS=deepseek-v3-2-251201,glm-4-7-251222,doubao-seed-2-0-pro-260215,doubao-1-5-vision-pro-32k-250115,kimi-k2-250905,kimi-k2-thinking-251104
# VOLCENGINE_ARK_IMAGE_MODELS=doubao-seedream-5-0-260128,doubao-seedream-4-0-250828,doubao-seedream-4-5-251128
# HUGGINGFACE_MODELS=deepseek-ai/DeepSeek-R1:fastest,Qwen/Qwen3-8B:fastest
# GITHUB_MODELS_MODELS=openai/gpt-4o-mini,openai/gpt-4.1-mini
# SILICONFLOW_MODELS=Qwen/Qwen3-8B,Qwen/Qwen3-14B
# CEREBRAS_MODELS=gpt-oss-120b,llama3.1-8b
# SAMBANOVA_MODELS=DeepSeek-V3.2,gpt-oss-120b

# Optional custom fallback providers:
# AGENT_MODEL_PROVIDERS=Name|https://provider.example/v1|model-id|optional-api-key;Another|https://example.com/openai|openai|
